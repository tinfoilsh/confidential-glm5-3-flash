+"""Request-ordered dispatch for cooperative API output processing."""
+
+from __future__ import annotations
+
+import asyncio
+from collections import deque
+from dataclasses import dataclass, field
+
+
+@dataclass
+class PendingOutput:
+    output: object
+    engine_index: int
+    engine_timestamp: float
+    statistics: object | None
+    tensor_bytes: int
+
+
+@dataclass
+class RequestWork:
+    queue: deque = field(default_factory=deque)
+    current: PendingOutput | None = None
+    task: asyncio.Task | None = None
+
+
+class RequestOutputDispatcher:
+    def __init__(self, processor, task_group, *, chunk_entries, heavy_slots,
+                 tensor_budget_bytes, yield_outputs, new_statistics,
+                 record_statistics, abort_engine, observe_backlog):
+        if min(chunk_entries, heavy_slots, tensor_budget_bytes, yield_outputs) <= 0:
+            raise ValueError("Dispatcher limits must be positive")
+        self.processor = processor
+        self.task_group = task_group
+        self.chunk_entries = chunk_entries
+        self.tensor_budget_bytes = tensor_budget_bytes
+        self.yield_outputs = yield_outputs
+        self.new_statistics = new_statistics
+        self.record_statistics = record_statistics
+        self.abort_engine = abort_engine
+        self.observe_backlog = observe_backlog
+        self.heavy_slot = asyncio.Semaphore(heavy_slots)
+        self.work = {}
+        self.closed = False
+        self.pending_tensor_bytes = 0
+        self.active_heavy = 0
+        self.idle = asyncio.Event()
+        self.readable = asyncio.Event()
+        self._observe()
+
+    def is_heavy(self, output):
+        tensors = output.new_prompt_logprobs_tensors
+        return (output.pooling_output is None and tensors is not None
+                and tensors.logprobs.numel() > self.chunk_entries)
+
+    @staticmethod
+    def _tensor_bytes(output):
+        size = 0
+        tensors = output.new_prompt_logprobs_tensors
+        if tensors is not None:
+            size += sum(tensor.numel() * tensor.element_size() for tensor in tensors[:3])
+        if output.prompt_token_id_logprobs is not None:
+            tensor = output.prompt_token_id_logprobs
+            size += tensor.numel() * tensor.element_size()
+        if output.new_logprobs is not None:
+            size += sum(array.nbytes for array in output.new_logprobs[:3])
+        return size
+
+    def _observe(self):
+        pending_outputs = sum(len(work.queue) + (work.current is not None) for work in self.work.values())
+        self.observe_backlog(len(self.work), pending_outputs, self.pending_tensor_bytes, self.active_heavy)
+        (self.idle.clear if self.work else self.idle.set)()
+        (self.readable.set if self.pending_tensor_bytes < self.tensor_budget_bytes else self.readable.clear)()
+
+    async def wait_readable(self):
+        await self.readable.wait()
+
+    async def wait_idle(self):
+        await self.idle.wait()
+
+    async def submit(self, output, engine_index, engine_timestamp, iteration_timestamp=None):
+        if self.closed:
+            raise RuntimeError("Output dispatcher is closed")
+        state = self.processor.request_states.get(output.request_id)
+        if state is None:
+            return
+        statistics = self.new_statistics(iteration_timestamp) if iteration_timestamp is not None else None
+        item = PendingOutput(output, engine_index, engine_timestamp, statistics, self._tensor_bytes(output))
+        work = self.work.get(state)
+        if work is None and not self.is_heavy(output):
+            result = self.processor.process_outputs([output], engine_timestamp, statistics)
+            await self._record_result(result, item)
+            return
+        if work is None:
+            work = RequestWork()
+            self.work[state] = work
+            work.task = self.task_group.create_task(self._run_request(state, work))
+            work.task.add_done_callback(lambda task: self._release_work(state, work))
+        work.queue.append(item)
+        self.pending_tensor_bytes += item.tensor_bytes
+        self._observe()
+
+    async def _record_result(self, result, item):
+        assert not result.request_outputs
+        if item.statistics is not None:
+            self.record_statistics(item.engine_index, item.statistics)
+        if result.reqs_to_abort:
+            await self.abort_engine(result.reqs_to_abort)
+
+    async def _run_request(self, state, work):
+        processed_count = 0
+        try:
+            while work.queue:
+                work.current = work.queue.popleft()
+                item = work.current
+                if self.processor.request_states.get(state.request_id) is state:
+                    if self.is_heavy(item.output):
+                        async with self.heavy_slot:
+                            if self.processor.request_states.get(state.request_id) is state:
+                                self.active_heavy += 1
+                                self._observe()
+                                try:
+                                    result = await self.processor.process_outputs_async(
+                                        [item.output], item.engine_timestamp, item.statistics)
+                                finally:
+                                    self.active_heavy -= 1
+                                    self._observe()
+                                await self._record_result(result, item)
+                    else:
+                        result = self.processor.process_outputs(
+                            [item.output], item.engine_timestamp, item.statistics)
+                        await self._record_result(result, item)
+                self.pending_tensor_bytes -= item.tensor_bytes
+                work.current = None
+                item = None
+                self._observe()
+                processed_count += 1
+                if work.queue and processed_count % self.yield_outputs == 0:
+                    await asyncio.sleep(0)
+        finally:
+            item = None
+            self._release_work(state, work)
+
+    def _release_work(self, state, work):
+        if self.work.get(state) is not work:
+            return
+        if work.current is not None:
+            self.pending_tensor_bytes -= work.current.tensor_bytes
+            work.current = None
+        while work.queue:
+            self.pending_tensor_bytes -= work.queue.popleft().tensor_bytes
+        self.work.pop(state)
+        self._observe()
+
+    def cancel_aborted(self, internal_request_ids):
+        request_ids = set(internal_request_ids)
+        for state, work in tuple(self.work.items()):
+            if state.request_id in request_ids and self.processor.request_states.get(state.request_id) is not state:
+                work.task.cancel()
+
+    async def close(self):
+        self.closed = True
+        tasks = [work.task for work in self.work.values()]
+        for task in tasks:
+            task.cancel()
+        if tasks:
+            await asyncio.gather(*tasks, return_exceptions=True)
+        assert not self.work and self.pending_tensor_bytes == 0 and self.active_heavy == 0
