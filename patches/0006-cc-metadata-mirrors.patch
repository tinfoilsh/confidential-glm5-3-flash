+class CpuMetadataTensor(UvaBackedTensor):
+    """Reuse a published device view while its CPU-owned metadata is unchanged."""
+
+    def __init__(
+        self,
+        size: int | Sequence[int],
+        dtype: torch.dtype,
+        max_concurrency: int | None = None,
+    ):
+        super().__init__(size, dtype, max_concurrency)
+        self._cache_unchanged = (
+            envs.VLLM_TINFOIL_CC_OPTIMIZATIONS and not is_uva_available()
+        )
+        self._last_published: np.ndarray | None = None
+
+    def copy_to_uva(self, n: int | None = None) -> torch.Tensor:
+        if not self._cache_unchanged:
+            return super().copy_to_uva(n)
+        try:
+            if (
+                n is None
+                and self._last_published is not None
+                and np.array_equal(self.np, self._last_published)
+            ):
+                return self.gpu
+            self._last_published = None
+            snapshot = self.np.copy() if n is None else None
+            result = super().copy_to_uva(n)
+            self._last_published = snapshot
+            return result
+        except BaseException:
+            self._last_published = None
+            raise
 
 
