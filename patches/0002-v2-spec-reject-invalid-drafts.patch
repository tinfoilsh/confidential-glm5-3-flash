+        # tinfoil: grammar-invalid drafts arrive as -1 sentinels in
+        # scheduled_spec_decode_tokens, but req_states.draft_tokens still holds
+        # the raw speculator output, so the rejection sampler never sees them
+        # and can accept grammar-illegal drafts (vllm#46118, vllm#49694). The
+        # V1 runner scatters the sentinels into its input batch; mirror that.
+        has_invalid_drafts = False
         if not draft_tokens:
             # No draft token scheduled (common case).
             total_num_draft_tokens = 0
@@ -1248,6 +1254,28 @@
                 dtype=np.int32,
                 count=num_reqs,
             )
+            invalid_spec = scheduler_output.num_invalid_spec_tokens
+            if invalid_spec and any(invalid_spec.values()):
+                rows: list[int] = []
+                cols: list[int] = []
+                vals: list[int] = []
+                for req_id, num_invalid in invalid_spec.items():
+                    if not num_invalid:
+                        continue
+                    state_idx = self.req_states.req_id_to_index.get(req_id)
+                    spec_tokens = draft_tokens.get(req_id)
+                    if state_idx is None or not spec_tokens:
+                        continue
+                    for j, tok in enumerate(spec_tokens):
+                        rows.append(state_idx)
+                        cols.append(j)
+                        vals.append(tok)
+                if rows:
+                    has_invalid_drafts = True
+                    self.req_states.draft_tokens[
+                        torch.tensor(rows, dtype=torch.long, device=self.device),
+                        torch.tensor(cols, dtype=torch.long, device=self.device),
+                    ] = torch.tensor(vals, dtype=torch.int64, device=self.device)
             num_bonus_tokens = self.model_state.num_new_sampled_tokens_per_step
             total_num_draft_tokens = int(num_draft_tokens_per_req.sum())
             total_num_logits = num_reqs * num_bonus_tokens + total_num_draft_tokens
@@ -1345,6 +1373,13 @@
