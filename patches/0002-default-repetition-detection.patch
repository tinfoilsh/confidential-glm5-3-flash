+@lru_cache(maxsize=1)
+def _tinfoil_repetition_detection_default() -> RepetitionDetectionParams | None:
+    raw = os.environ.get(
+        "TINFOIL_REPETITION_DETECTION", _TINFOIL_REPETITION_DETECTION_DEFAULT
+    ).strip()
+    if raw in ("", "0", "off"):
+        return None
+    try:
+        max_pattern, min_pattern, min_count = (int(v) for v in raw.split(","))
+        return RepetitionDetectionParams(
+            max_pattern_size=max_pattern,
+            min_pattern_size=min_pattern,
+            min_count=min_count,
+        )
+    except (ValueError, VLLMValidationError) as exc:
+        logger.warning("Ignoring invalid TINFOIL_REPETITION_DETECTION=%r: %s", raw, exc)
+        return None
 
 
